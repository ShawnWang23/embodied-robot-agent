# Optional Phase 3 OpenAI planner. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Optional SiliconFlow OpenAI-compatible planner.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash

# FastAPI runtime. The service binds to 127.0.0.1 by default.
ROBOT_AGENT_PLANNER=rule
ROBOT_AGENT_LOCATIONS=config/locations.json
ROBOT_AGENT_TASK_DB=data/api_tasks.db
ROBOT_AGENT_CHECKPOINT_DB=data/checkpoints.db

